<Window x:Class="trpo_pract7_Savitsin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:trpo_pract7_Savitsin"
        xmlns:models="clr-namespace:trpo_pract7_Savitsin.Models"
        xmlns:converters="clr-namespace:trpo_pract7_Savitsin.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <models:Deposit x:Key="deposit"/>
        <converters:AnnualRateConverter x:Key="annualRateConverter"/>
    </Window.Resources>
    <Window.DataContext>
        <Binding Source="{StaticResource deposit}"/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="5">
            
            <StackPanel>
                <Label>Имя клиента</Label>
                <TextBox Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel>
                <Label>Сумма</Label>
                <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel>
                <Label>Годовая ставка</Label>
                <TextBox Text="{Binding AnnualRate, Converter={StaticResource annualRateConverter}, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel>
                <Label>Количество месяцев</Label>
                <TextBox Text="{Binding Months, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Column="1" Margin="5">

            <StackPanel>
                <Label>Имя клиента:</Label>
                <TextBlock Text="{Binding ClientName}"/>
            </StackPanel>

            <StackPanel>
                <Label>Сумма:</Label>
                <TextBlock Text="{Binding Amount, StringFormat={}{0:C}}"/>
            </StackPanel>

            <StackPanel>
                <Label>Годовая ставка:</Label>
                <TextBlock Text="{Binding AnnualRate, StringFormat={}{0:F2}}"/>
            </StackPanel>

            <StackPanel>
                <Label>Количество месяцев:</Label>
                <TextBlock Text="{Binding Months}"/>
            </StackPanel>

            <StackPanel>
                <Label>Доход:</Label>
                <TextBlock Text="{Binding Income, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

        </StackPanel>
        
    </Grid>
</Window>
